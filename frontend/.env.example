# ParcelPilot Frontend — Environment Variables Template
# Copy to frontend/.env for local development. NEVER commit frontend/.env.

# Local development (default — points to local backend):
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (Vercel environment variable — set in Vercel dashboard):
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
