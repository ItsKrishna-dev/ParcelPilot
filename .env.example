# --- Database ---
DATABASE_URL=postgresql+psycopg2://parcelpilot:parcelpilot@localhost:5432/parcelpilot

# --- LLM Providers (free tiers only) ---
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

LLM_PRIMARY_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=groq

# --- Embeddings (local, free) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- App ---
DATASET_SNAPSHOT_TIME=2026-08-16T11:00:00+05:30
APP_SECRET_KEY=change_me_in_production
MANAGER_APPROVAL_THRESHOLD_INR=1000
PENDING_ACTION_TTL_SECONDS=600
