# =============================================================================
# ParcelPilot Backend — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Database ---
# Local Docker PostgreSQL (default when running via docker-compose):
DATABASE_URL=postgresql+psycopg2://parcelpilot:parcelpilot@localhost:5433/parcelpilot

# Neon PostgreSQL (for local development against Neon, or Render deployment):
# DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/neondb?sslmode=require&channel_binding=require

# --- Deployment Environment ---
# Set to "production" on Render. Leave "development" locally.
ENVIRONMENT=development

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL when deploying to production.
# Example: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM Providers (free tiers only) ---
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=nvidia

# Groq (Primary)
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=768

# NVIDIA NIM (Fallback Provider)
NVIDIA_NIM_API_KEY=your_nvidia_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- Orchestrator & LLM Limits ---
LLM_MAX_TOOL_ITERATIONS=4
LLM_RETRY_MAX_ATTEMPTS=0

# --- Embeddings (local, free — no API key required) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3
RETRIEVAL_MAX_CHUNK_CHARS=1200

# --- App & Assessment Parameters ---
DATASET_SNAPSHOT_TIME=2026-08-16T11:00:00+05:30
APP_SECRET_KEY=change_me_in_production
MANAGER_APPROVAL_THRESHOLD_INR=1000
PENDING_ACTION_TTL_SECONDS=600

# --- Optional Database Pool Tuning (Render free-tier safe defaults apply) ---
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300
